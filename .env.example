# Postgres del plano frío. Es la única dependencia dura del sistema (ARD §7).
DATABASE_URL=postgres://momentum:momentum@localhost:5432/momentum
TEST_DATABASE_URL=postgres://momentum:momentum@localhost:5432/momentum_test

# Cadencia del plano frío (PRD §6: máximo 15 minutos).
INGEST_CRON=*/15 * * * *
OUTCOMES_CRON=0 3 * * *

# Reddit: sin credenciales usa el endpoint público con límite de tasa bajo.
# Con credenciales de app (script), la cuota es la del cliente OAuth.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=momentum/0.1 (cold-plane ingest)

# Puerta de entrada para extractores externos (n8n). Sin este token el endpoint
# /ingest/snapshot responde 503: cerrado por defecto, no abierto por defecto.
INGEST_TOKEN=

# Esquema donde vive Momentum. Permite compartir un Postgres con otro proyecto
# sin pisarle nada: todo lo nuestro queda bajo `momentum.*`.
DB_SCHEMA=momentum

# Prefijo del sitio en el build. GitHub Pages de proyecto sirve bajo /<repo>/.
SITE_BASE=/
